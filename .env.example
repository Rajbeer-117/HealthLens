# HealthLens AI settings: copy this file to ".env" and pick ONE provider.
# Never commit your real .env (it is in .gitignore).

# auto (default: Ollama if running, else API key below, else offline) | offline | ollama | anthropic | openai
HEALTHLENS_LLM_PROVIDER=auto

# Optional: override the default model for the chosen provider
# HEALTHLENS_LLM_MODEL=

# ---------- Option A: Ollama (free, runs on your laptop; data never leaves the machine)
# Install from https://ollama.com, then run:  ollama pull llama3.2
# HEALTHLENS_LLM_PROVIDER=ollama
# HEALTHLENS_LLM_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# ---------- Option B: Claude (Anthropic API)
# HEALTHLENS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# HEALTHLENS_LLM_MODEL=claude-haiku-5-5

# ---------- Option C: any OpenAI-compatible API
# OpenAI:
# HEALTHLENS_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# HEALTHLENS_LLM_MODEL=gpt-4o-mini
#
# Google Gemini (free tier), same provider setting:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=<your Gemini API key>
# (use a current Flash model name from Google AI Studio)
# HEALTHLENS_LLM_MODEL=gemini-2.5-flash
#
# Groq (free tier):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=<your Groq key>
# HEALTHLENS_LLM_MODEL=llama-3.1-8b-instant

# Seconds to wait for the LLM before falling back to the template explanation
HEALTHLENS_LLM_TIMEOUT=120

# Keeps you signed in across server restarts (any long random string)
# HEALTHLENS_SECRET_KEY=change-me
